# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
keystore/

# --- foundry -----------------------------------------------------------------
packages/contracts/out/
packages/contracts/cache/
# Running forge with --root from the repo root writes here instead. The
# invariant failure cache in particular must not be committed: a stale entry
# makes a later run replay a sequence for a bug that has already been fixed.
/cache/
/out/
/broadcast/
packages/contracts/broadcast/
!packages/contracts/broadcast/**/dry-run/
packages/contracts/lib/
docs-gen/

# --- node --------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
.next/
.turbo/
coverage/
lcov.info
*.tsbuildinfo

# --- indexer -----------------------------------------------------------------
.ponder/
generated/

# --- editors / os ------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.log
