# =============================================================================
# Capital DAO — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# --- RPC ---------------------------------------------------------------------
# An ARCHIVE endpoint is REQUIRED to run the fork tests as configured.
#
# The public RPC is not one. Measured 2026-09-10: state only 1,000 blocks back
# already returns `metadata is not found`, and it rate limits under a plain test
# run. The fork tests pin to a fixed block (BaseTest.FORK_BLOCK_DEFAULT) so that
# a failure means our code changed rather than the chain moving, and pinning
# needs history the public endpoint does not keep.
#
# Alchemy serves this chain's state back to block 1. Put your own key below.
RH_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
RH_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=

# Public endpoints — fine for casual reads, unusable for pinned fork tests,
# production frontends or indexers.
# RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- deployment keys ---------------------------------------------------------
# Prefer a Foundry keystore over a raw private key:
#   cast wallet import capdao-deployer --interactive
#   forge script ... --account capdao-deployer
# Only use PRIVATE_KEY for throwaway testnet wallets.
PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- verification ------------------------------------------------------------
# Robinhood Chain uses Blockscout.
#
# ⚠️ Automated contract verification does NOT currently work on mainnet.
# The mainnet explorer's API sits behind a Cloudflare managed challenge and
# returns 403 to every programmatic request — v1 and v2 endpoints, with or
# without a browser User-Agent. Measured 2026-09-12:
#
#   robinhoodchain.blockscout.com/api            -> 403
#   robinhoodchain.blockscout.com/api/v2/...     -> 403
#   robinhoodchain.blockscout.com/  (HTML)       -> 200   (a browser solves it)
#   explorer.testnet.chain.robinhood.com/api     -> 200   (testnet is fine)
#
# So `forge verify-contract` cannot reach mainnet, and an API key does not help.
# Verify through the explorer's web UI instead, or use testnet where the API
# works. Re-check periodically; this is a Cloudflare rule, not a design choice.
#
# One more reason to be careful with this key: Blockscout takes it as a URL
# query parameter, and forge prints the failing request URL verbatim on error —
# so a failed verification dumps the key into whatever log it runs in. Do not
# put it in CI without confirming the failure path stays quiet.
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_KEY=

# --- frontend (packages/web) -------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- indexer (packages/indexer) ----------------------------------------------
# Ponder. Without DATABASE_URL it falls back to a local PGlite database under
# packages/indexer/.ponder, which is fine for development and not for anything
# else. DATABASE_SCHEMA is required either way — Ponder refuses to start without
# being told which schema to own, so it cannot clobber a shared one by accident.
DATABASE_URL=
DATABASE_SCHEMA=futarchy
#
# Use the archive endpoint here too. The indexer replays from the deployment
# block, which the public RPC cannot serve (it loses state within ~1,000 blocks).
PONDER_RPC_URL_4663=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
