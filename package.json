{
  "name": "hoodarchy",
  "version": "0.0.0",
  "private": true,
  "description": "Hoodarchy \u2014 futarchy-governed treasuries on Robinhood Chain.",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "forge build --root packages/contracts",
    "test": "forge test --root packages/contracts",
    "test:fork": "forge test --root packages/contracts --match-path 'test/fork/*' -vv",
    "test:fork:drift": "FORK_BLOCK=0 forge test --root packages/contracts --match-path 'test/fork/*' -vv",
    "fmt": "forge fmt --root packages/contracts",
    "fmt:check": "forge fmt --root packages/contracts --check",
    "lint": "slither packages/contracts || true",
    "coverage": "forge coverage --root packages/contracts",
    "gas": "forge test --root packages/contracts --gas-report",
    "chain:check": "node packages/chain/scripts/verify-addresses.mjs",
    "docs:check": "node scripts/check-docs-links.mjs",
    "abis": "node scripts/export-abis.mjs",
    "abis:check": "node scripts/export-abis.mjs --check",
    "typecheck": "tsc --noEmit",
    "deployment:check": "node scripts/check-deployment-abi.mjs",
    "verify": "pnpm fmt:check && pnpm build && pnpm abis:check && pnpm typecheck && pnpm --filter @hoodarchy/indexer exec tsc --noEmit && pnpm docs:check && forge test --root packages/contracts --no-match-path 'test/fork/*'",
    "verify:chain": "pnpm chain:check && pnpm test:fork && pnpm test:fork:drift && pnpm deployment:check"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "viem": "^2.21.0"
  }
}
